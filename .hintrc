{
  "extends": [
    "development"
  ],
  "browserslist": [
    "defaults",
    "not ie 11",
    "not and_ff <= 127",
    "not firefox <= 128",
    "not and_chr <= 127",
    "not chrome <= 127",
    "not edge <= 127",
    "not ios_saf <= 17.5",
    "not opera <= 111",
    "not safari <= 17.5",
    "not samsung <= 25",
    "not ios_saf <= 18.5",
    "not safari <= 18.5",
    "not samsung <= 28"
  ],
  "hints": {
    "axe/structure": "off",
    "compat-api/css": [
      "default",
      {
        "ignore": [
          "scrollbar-width",
          "scrollbar-color"
        ]
      }
    ],
    "axe/keyboard": [
      "default",
      {
        "nested-interactive": "off"
      }
    ],
    "no-inline-styles": "off",
    "axe/name-role-value": [
      "default",
      {
        "link-name": "off"
      }
    ],
    "disown-opener": "off"
  }
}